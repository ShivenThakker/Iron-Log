{
  "name": "ironlog-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:api": "npm run dev --workspace=api",
    "seed:exercises": "npm run seed --workspace=api",
    "start:mobile": "npm run start --workspace=mobile"
  },
  "allowScripts": {
    "better-sqlite3@12.8.0": true,
    "esbuild@0.27.4": true,
    "prisma@7.5.0": true,
    "@prisma/engines@7.5.0": true
  }
}
