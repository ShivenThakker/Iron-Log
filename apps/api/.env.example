# IronLog API Environment Configuration
PORT=3000
NODE_ENV=development

# Database: Supabase PostgreSQL (Project: hqzhgdjoksfgqojairzq)
# Direct connection: db.hqzhgdjoksfgqojairzq.supabase.co:5432
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.hqzhgdjoksfgqojairzq.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.hqzhgdjoksfgqojairzq.supabase.co:5432/postgres"

# JWT Secrets
JWT_SECRET=your_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars

# Google Gemini 2.0 Flash API (Get free key from https://aistudio.google.com)
GEMINI_API_KEY=

# Upstash Redis (Optional for local dev - has built-in in-memory fallback)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google OAuth (Optional - for Google Sign-In verification)
GOOGLE_CLIENT_ID=

# USDA FoodData Central API (Optional - free key from https://fdc.nal.usda.gov)
USDA_API_KEY=
